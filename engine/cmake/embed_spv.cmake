# Generates a C header embedding SPIR-V binaries: -DSPV_FILES=a.spv;b.spv -DNAMES=A;B -DOUT=hdr
string(REPLACE "," ";" SPV_FILES "${SPV_FILES}")
string(REPLACE "," ";" NAMES "${NAMES}")
set(content "#pragma once\n#include <cstddef>\n")
list(LENGTH SPV_FILES nfiles)
math(EXPR last "${nfiles} - 1")
foreach(i RANGE 0 ${last})
    list(GET SPV_FILES ${i} spv)
    list(GET NAMES ${i} name)
    file(READ "${spv}" hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(APPEND content "alignas(4) static const unsigned char ${name}[] = {${bytes}};\n")
    string(APPEND content "static const size_t ${name}Words = sizeof(${name}) / 4;\n")
endforeach()
file(WRITE "${OUT}" "${content}")
